	<string>CleanOS scans file sizes only. Grant Full Disk Access so this prompt does not repeat.</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>CleanOS asks Finder to empty the Trash on other disks, and System Events to list and remove your login items.</string>
	<key>NSDesktopFolderUsageDescription</key>
	<string>CleanOS looks for screenshots, installers and application aliases on your Desktop.</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>CleanOS looks for large files, duplicates and application service files in your Documents.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>CleanOS looks for installers and large files in your Downloads.</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Joe Costello. MIT License.</string>
	<key>NSNetworkVolumesUsageDescription</key>
	<string>CleanOS can scan network volumes when you enable them in Settings.</string>
	<key>NSRemovableVolumesUsageDescription</key>
	<string>CleanOS scans external disks for junk, purgeable space and application service files.</string>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>
	<key>SUAutomaticallyUpdate</key>
	<true/>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUFeedURL</key>
	<string>https://github.com/$(CLEANOS_GITHUB_REPO)/releases/latest/download/appcast.xml</string>
