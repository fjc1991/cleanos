{
  "comment": "Paths and identifiers CleanOS never removes, whatever the scanner finds. Prefixes end with a slash.",
  "pathPrefixes": [
    "/System/",
    "/usr/bin/",
    "/usr/sbin/",
    "/usr/lib/",
    "/usr/libexec/",
    "/usr/share/",
    "/usr/standalone/",
    "/bin/",
    "/sbin/",
    "/private/etc/",
    "/etc/",
    "/Library/Apple/",
    "/Library/Developer/CommandLineTools/",
    "/private/var/db/",
    "/dev/",
    "/Volumes/Recovery/",
    "/Library/Keychains/",
    "/Library/Security/"
  ],
  "exactPaths": [
    "/",
    "/Applications",
    "/Applications/Utilities",
    "/Library",
    "/Users",
    "/Users/Shared",
    "/Volumes",
    "/private",
    "/private/var",
    "/private/tmp",
    "/opt",
    "/usr/local",
    "/opt/homebrew",
    "~",
    "~/Library",
    "~/Library/Application Support",
    "~/Library/Caches",
    "~/Library/Preferences",
    "~/Library/Containers",
    "~/Library/Group Containers",
    "~/Library/Logs",
    "~/Desktop",
    "~/Documents",
    "~/Downloads",
    "~/Movies",
    "~/Music",
    "~/Pictures"
  ],
  "bundleIdentifierPrefixes": [
    "com.apple.",
    "group.com.apple.",
    "systemgroup.com.apple.",
    "apple.",
    "com.cleanos.",
    "org.cups.",
    "org.swift.",
    "com.openssh.",
    "org.openbsd.",
    "org.pqrs.",
    "com.github.homebrew.",
    "is.workflow.",
    "group.is.workflow.",
    "group.tvappservices.",
    "com.icloud.",
    "iCloud.com.apple."
  ],
  "hostsFileLinesKept": [
    "127.0.0.1",
    "255.255.255.255",
    "::1",
    "fe80::1%lo0"
  ],
  "bundleIdentifierContains": [
    ".com.apple.",
    "~com~apple~",
    ".groups.com.apple."
  ]
}
