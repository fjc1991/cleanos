{
  "version": 1,
  "comment": "Every root the deep dive lists. `match` lists the identity signals allowed for children of this root; `nameStyle` says how a child name is reduced to an identifier before matching; `depth` 2 means vendor folders are looked into. Tiers: safe (regenerable), normal (settings/data), caution (user content or shared), protected (never selectable). `needsRoot` marks roots that may hold root-owned items; each item still needs root only when the user cannot remove it. Sources: nektony binary strings, Pearcleaner Locations.swift, Homebrew cask zap stanzas, Apple File System Programming Guide, survey of this Mac.",
  "roots": [
    { "id": "user-app-support", "root": "~/Library/Application Support", "depth": 2, "group": "Application Support", "tier": "normal",
      "match": ["bundleID", "subBundleID", "extensionID", "groupID", "name", "executable", "vendor"], "nameStyle": "folder",
      "skipChildren": ["com.apple.sharedfilelist", "CrashReporter", "FileProvider", "CloudDocs", "MobileSync", "AddressBook", "iCloud", "Knowledge", "com.apple.TCC"] },
    { "id": "user-crash-reporter", "root": "~/Library/Application Support/CrashReporter", "depth": 1, "group": "Crash Reports", "tier": "safe",
      "match": ["name", "executable", "processName"], "nameStyle": "crashReport" },
    { "id": "user-recent-documents", "root": "~/Library/Application Support/com.apple.sharedfilelist/com.apple.LSSharedFileList.ApplicationRecentDocuments", "depth": 1, "group": "Traces", "tier": "safe",
      "match": ["bundleID", "subBundleID"], "nameStyle": "sfl" },
    { "id": "user-fileprovider", "root": "~/Library/Application Support/FileProvider", "depth": 1, "group": "Cloud", "tier": "caution",
      "match": ["bundleID", "extensionID"], "nameStyle": "folder" },
    { "id": "user-cloudstorage", "root": "~/Library/CloudStorage", "depth": 1, "group": "Cloud", "tier": "caution",
      "match": ["name", "vendor"], "nameStyle": "cloudStorage" },
    { "id": "user-clouddocs-containers", "root": "~/Library/Application Support/CloudDocs/session/containers", "depth": 1, "group": "Cloud", "tier": "caution",
      "match": ["iCloudID", "bundleID"], "nameStyle": "iCloudContainer" },
    { "id": "user-caches", "root": "~/Library/Caches", "depth": 2, "group": "Caches", "tier": "safe",
      "match": ["bundleID", "subBundleID", "extensionID", "groupID", "teamGroup", "name", "executable", "vendor"], "nameStyle": "folder",
      "skipChildren": ["com.apple.helpd", "com.apple.nsurlsessiond", "CloudKit", "com.plausiblelabs.crashreporter.data", "SentryCrash", "KSCrash", "KSCrashReports", "com.crashlytics.data", "com.bugsnag.Bugsnag", "Rollbar", "Amplitude", "com.segment.analytics", "Realm", "Parse", "org.sparkle-project.Sparkle", "com.hockeyapp.sdk.mac"] },
    { "id": "user-caches-help", "root": "~/Library/Caches/com.apple.helpd/Generated", "depth": 1, "group": "Caches", "tier": "safe",
      "match": ["bundleID", "subBundleID"], "nameStyle": "helpCache" },
    { "id": "user-caches-nsurlsessiond", "root": "~/Library/Caches/com.apple.nsurlsessiond/Downloads", "depth": 1, "group": "Caches", "tier": "safe",
      "match": ["bundleID", "subBundleID", "extensionID"], "nameStyle": "folder" },
    { "id": "user-caches-cloudkit", "root": "~/Library/Caches/CloudKit", "depth": 1, "group": "Caches", "tier": "safe",
      "match": ["bundleID", "subBundleID", "iCloudID"], "nameStyle": "folder" },
    { "id": "user-caches-cloudkit-bird", "root": "~/Library/Caches/CloudKit/com.apple.bird", "depth": 1, "group": "Caches", "tier": "safe",
      "match": ["iCloudID", "bundleID"], "nameStyle": "iCloudContainer" },
    { "id": "user-caches-sdk", "roots": [
        "~/Library/Caches/com.plausiblelabs.crashreporter.data", "~/Library/Caches/SentryCrash", "~/Library/Caches/KSCrash",
        "~/Library/Caches/KSCrashReports", "~/Library/Caches/com.crashlytics.data", "~/Library/Caches/com.bugsnag.Bugsnag",
        "~/Library/Caches/Rollbar", "~/Library/Caches/Amplitude", "~/Library/Caches/com.segment.analytics", "~/Library/Caches/Realm",
        "~/Library/Caches/Parse", "~/Library/Caches/org.sparkle-project.Sparkle", "~/Library/Caches/com.hockeyapp.sdk.mac",
        "~/Library/Application Support/com.bugsnag.Bugsnag"],
      "depth": 1, "group": "Crash Reports", "tier": "safe", "match": ["bundleID", "subBundleID", "name", "executable"], "nameStyle": "folder" },
    { "id": "user-darwin-cache", "root": "$DARWIN_USER_CACHE_DIR", "depth": 1, "group": "Caches", "tier": "safe",
      "match": ["bundleID", "subBundleID", "extensionID"], "nameStyle": "folder" },
    { "id": "user-darwin-temp", "root": "$DARWIN_USER_TEMP_DIR", "depth": 1, "group": "Temporary Files", "tier": "safe",
      "match": ["bundleID", "subBundleID", "extensionID"], "nameStyle": "folder" },
    { "id": "user-darwin-persistent", "root": "$DARWIN_USER_DIR", "depth": 1, "group": "Caches", "tier": "safe",
      "match": ["bundleID", "subBundleID", "extensionID"], "nameStyle": "folder" },
    { "id": "user-preferences", "root": "~/Library/Preferences", "depth": 1, "group": "Preferences", "tier": "normal",
      "match": ["bundleID", "subBundleID", "extensionID", "groupID", "teamGroup", "name", "vendor"], "nameStyle": "plist",
      "skipChildren": ["ByHost", "com.apple.LaunchServices", "com.apple.FileProvider"] },
    { "id": "user-preferences-byhost", "root": "~/Library/Preferences/ByHost", "depth": 1, "group": "Preferences", "tier": "normal",
      "match": ["bundleID", "subBundleID", "extensionID"], "nameStyle": "byHostPlist" },
    { "id": "user-preferences-fileprovider", "root": "~/Library/Preferences/com.apple.FileProvider", "depth": 1, "group": "Cloud", "tier": "normal",
      "match": ["bundleID", "extensionID"], "nameStyle": "folder" },
    { "id": "user-containers", "root": "~/Library/Containers", "depth": 1, "group": "Containers", "tier": "normal",
      "match": ["bundleID", "subBundleID", "extensionID"], "nameStyle": "container" },
    { "id": "user-group-containers", "root": "~/Library/Group Containers", "depth": 1, "group": "Group Containers", "tier": "normal",
      "match": ["groupID", "teamGroup", "bundleID"], "nameStyle": "folder" },
    { "id": "user-application-scripts", "root": "~/Library/Application Scripts", "depth": 1, "group": "Containers", "tier": "normal",
      "match": ["bundleID", "subBundleID", "extensionID", "groupID", "teamGroup"], "nameStyle": "folder" },
    { "id": "user-daemon-containers", "root": "~/Library/Daemon Containers", "depth": 1, "group": "Containers", "tier": "normal",
      "match": ["bundleID", "subBundleID"], "nameStyle": "container" },
    { "id": "user-httpstorages", "root": "~/Library/HTTPStorages", "depth": 1, "group": "Web Storage", "tier": "normal",
      "match": ["bundleID", "subBundleID", "extensionID", "executable", "name"], "nameStyle": "binarycookies" },
    { "id": "user-cookies", "root": "~/Library/Cookies", "depth": 1, "group": "Web Storage", "tier": "normal",
      "match": ["bundleID", "subBundleID"], "nameStyle": "binarycookies" },
    { "id": "user-webkit", "root": "~/Library/WebKit", "depth": 1, "group": "Web Storage", "tier": "normal",
      "match": ["bundleID", "subBundleID", "extensionID"], "nameStyle": "folder" },
    { "id": "user-saved-state", "root": "~/Library/Saved Application State", "depth": 1, "group": "Saved State", "tier": "safe",
      "match": ["bundleID", "subBundleID"], "nameStyle": "savedState" },
    { "id": "user-autosave", "root": "~/Library/Autosave Information", "depth": 1, "group": "Saved State", "tier": "caution",
      "match": ["name"], "nameStyle": "autosave" },
    { "id": "user-logs", "root": "~/Library/Logs", "depth": 1, "group": "Logs", "tier": "safe",
      "match": ["bundleID", "subBundleID", "name", "executable", "vendor"], "nameStyle": "log",
      "skipChildren": ["DiagnosticReports", "CrashReporter"] },
    { "id": "user-diagnostic-reports", "roots": ["~/Library/Logs/DiagnosticReports", "~/Library/Logs/DiagnosticReports/Retired"], "depth": 1, "group": "Crash Reports", "tier": "safe",
      "match": ["name", "executable", "processName"], "nameStyle": "crashReport" },
    { "id": "user-launch-agents", "root": "~/Library/LaunchAgents", "depth": 1, "group": "Login Items", "tier": "normal",
      "match": ["bundleID", "subBundleID", "label", "launchdProgram"], "nameStyle": "plist" },
    { "id": "user-core-spotlight", "root": "~/Library/Metadata/CoreSpotlight", "depth": 1, "group": "Indexes", "tier": "safe",
      "match": ["bundleID", "subBundleID"], "nameStyle": "folder" },
    { "id": "user-mobile-documents", "root": "~/Library/Mobile Documents", "depth": 1, "group": "Cloud", "tier": "caution",
      "match": ["iCloudID", "bundleID", "teamGroup"], "nameStyle": "mobileDocuments" },
    { "id": "user-synced-preferences", "root": "~/Library/SyncedPreferences", "depth": 1, "group": "Preferences", "tier": "normal",
      "match": ["bundleID", "subBundleID"], "nameStyle": "plist" },
    { "id": "user-plugins", "roots": [
        "~/Library/Internet Plug-Ins", "~/Library/PreferencePanes", "~/Library/QuickLook", "~/Library/Spotlight", "~/Library/Screen Savers",
        "~/Library/Services", "~/Library/Widgets", "~/Library/ColorPickers", "~/Library/Dictionaries", "~/Library/Input Methods",
        "~/Library/Keyboard Layouts", "~/Library/Contextual Menu Items", "~/Library/Address Book Plug-Ins", "~/Library/Automator",
        "~/Library/CoreImage", "~/Library/Compositions", "~/Library/Sounds", "~/Library/Fonts", "~/Library/Scripts", "~/Library/Script Libraries",
        "~/Library/Mail/Bundles", "~/Library/Safari/Extensions"],
      "depth": 1, "group": "Extensions", "tier": "normal", "match": ["bundleID", "subBundleID", "extensionID", "name", "vendor", "pluginBundleID"], "nameStyle": "bundleName" },
    { "id": "user-audio-plugins", "roots": [
        "~/Library/Audio/Plug-Ins/Components", "~/Library/Audio/Plug-Ins/VST", "~/Library/Audio/Plug-Ins/VST3", "~/Library/Audio/Plug-Ins/CLAP",
        "~/Library/Audio/Plug-Ins/HAL", "~/Library/Audio/Plug-Ins/MAS", "~/Library/Audio/Plug-Ins/MIDI Drivers"],
      "depth": 1, "group": "Extensions", "tier": "normal", "match": ["bundleID", "subBundleID", "name", "vendor", "pluginBundleID"], "nameStyle": "bundleName" },
    { "id": "user-xcode-extensions", "roots": ["~/Library/Developer/Xcode/Templates", "~/Library/Developer/Xcode/Plug-ins", "~/Library/Developer/Xcode/UserData/CodeSnippets"],
      "depth": 1, "group": "Extensions", "tier": "caution", "match": ["name", "vendor"], "nameStyle": "folder" },
    { "id": "user-library-vendor", "root": "~/Library", "depth": 1, "group": "Application Support", "tier": "normal",
      "match": ["name", "vendor"], "nameStyle": "folder", "onlyNonStandard": true },
    { "id": "user-dotfiles", "root": "~", "depth": 1, "group": "Dotfiles", "tier": "normal",
      "match": ["name", "vendor", "executable"], "nameStyle": "dotfile" },
    { "id": "user-xdg", "roots": ["~/.config", "~/.local/share", "~/.local/state", "~/.cache"], "depth": 1, "group": "Dotfiles", "tier": "normal",
      "match": ["name", "vendor", "executable", "bundleID"], "nameStyle": "folder" },
    { "id": "user-documents", "roots": ["~/Documents", "~/Desktop", "~/Movies", "~/Music", "~/Pictures"], "depth": 1, "group": "User Data", "tier": "caution",
      "match": ["name", "vendor"], "nameStyle": "folder" },
    { "id": "user-applications-copies", "roots": ["~/Applications", "~/Desktop"], "depth": 1, "group": "Executables", "tier": "normal",
      "match": ["aliasIntoApp"], "nameStyle": "folder" },

    { "id": "local-app-support", "root": "/Library/Application Support", "depth": 2, "group": "Application Support", "tier": "normal", "needsRoot": true,
      "match": ["bundleID", "subBundleID", "name", "executable", "vendor"], "nameStyle": "folder",
      "skipChildren": ["CrashReporter", "Apple", "App Store", "Script Editor", "com.apple.TCC", "ProApps", "iLifeMediaBrowser", "livefsd", "BTServer"] },
    { "id": "local-crash-reporter", "root": "/Library/Application Support/CrashReporter", "depth": 1, "group": "Crash Reports", "tier": "safe", "needsRoot": true,
      "match": ["name", "executable", "processName"], "nameStyle": "crashReport" },
    { "id": "local-caches", "root": "/Library/Caches", "depth": 1, "group": "Caches", "tier": "safe", "needsRoot": true,
      "match": ["bundleID", "subBundleID", "name", "vendor"], "nameStyle": "folder" },
    { "id": "local-preferences", "root": "/Library/Preferences", "depth": 1, "group": "Preferences", "tier": "normal", "needsRoot": true,
      "match": ["bundleID", "subBundleID", "vendor"], "nameStyle": "plist", "skipChildren": ["SystemConfiguration", "OpenDirectory", "Audio", "Logging", "Xsan", "DirectoryService"] },
    { "id": "local-managed-preferences", "root": "/Library/Managed Preferences/$USER", "depth": 1, "group": "Preferences", "tier": "protected", "needsRoot": true,
      "match": ["bundleID", "subBundleID"], "nameStyle": "plist" },
    { "id": "local-logs", "root": "/Library/Logs", "depth": 1, "group": "Logs", "tier": "safe", "needsRoot": true,
      "match": ["bundleID", "name", "executable", "vendor"], "nameStyle": "log", "skipChildren": ["DiagnosticReports"] },
    { "id": "local-diagnostic-reports", "roots": ["/Library/Logs/DiagnosticReports", "/Library/Logs/DiagnosticReports/Retired"], "depth": 1, "group": "Crash Reports", "tier": "safe", "needsRoot": true,
      "match": ["name", "executable", "processName"], "nameStyle": "crashReport" },
    { "id": "local-launch-agents", "root": "/Library/LaunchAgents", "depth": 1, "group": "Login Items", "tier": "normal", "needsRoot": true,
      "match": ["bundleID", "subBundleID", "label", "launchdProgram"], "nameStyle": "plist" },
    { "id": "local-launch-daemons", "root": "/Library/LaunchDaemons", "depth": 1, "group": "Login Items", "tier": "normal", "needsRoot": true,
      "match": ["bundleID", "subBundleID", "label", "launchdProgram"], "nameStyle": "plist" },
    { "id": "local-privileged-helpers", "root": "/Library/PrivilegedHelperTools", "depth": 1, "group": "Login Items", "tier": "normal", "needsRoot": true,
      "match": ["bundleID", "subBundleID", "label"], "nameStyle": "folder" },
    { "id": "local-frameworks", "roots": ["/Library/Frameworks", "/Library/Java/JavaVirtualMachines", "/Library/Ruby", "/Library/Perl"], "depth": 1, "group": "Runtime", "tier": "caution", "needsRoot": true,
      "match": ["name", "vendor", "pkgReceipt", "pluginBundleID"], "nameStyle": "bundleName" },
    { "id": "local-kexts", "roots": ["/Library/Extensions", "/Library/StagedExtensions/Library/Extensions"], "depth": 1, "group": "Kernel & System Extensions", "tier": "caution", "needsRoot": true,
      "match": ["bundleID", "subBundleID", "vendor", "pluginBundleID", "pkgReceipt"], "nameStyle": "bundleName" },
    { "id": "local-system-extensions", "root": "/Library/SystemExtensions", "depth": 2, "group": "Kernel & System Extensions", "tier": "protected", "needsRoot": true,
      "match": ["bundleID", "subBundleID", "extensionID", "pluginBundleID"], "nameStyle": "bundleName" },
    { "id": "local-audio-video-plugins", "roots": [
        "/Library/Audio/Plug-Ins/HAL", "/Library/Audio/Plug-Ins/Components", "/Library/Audio/Plug-Ins/VST", "/Library/Audio/Plug-Ins/VST3",
        "/Library/Audio/Plug-Ins/CLAP", "/Library/Audio/Plug-Ins/MIDI Drivers", "/Library/CoreMediaIO/Plug-Ins/DAL",
        "/Library/Application Support/Avid/Audio/Plug-Ins", "/Library/Application Support/Digidesign/Plug-Ins"],
      "depth": 1, "group": "Extensions", "tier": "normal", "needsRoot": true, "match": ["bundleID", "subBundleID", "name", "vendor", "pluginBundleID", "pkgReceipt"], "nameStyle": "bundleName" },
    { "id": "local-plugins", "roots": [
        "/Library/Internet Plug-Ins", "/Library/QuickLook", "/Library/Spotlight", "/Library/PreferencePanes", "/Library/Screen Savers",
        "/Library/Fonts", "/Library/Input Methods", "/Library/Keyboard Layouts", "/Library/ColorPickers", "/Library/Contextual Menu Items",
        "/Library/Dictionaries", "/Library/Services", "/Library/ScriptingAdditions", "/Library/Scripts", "/Library/Widgets", "/Library/Components",
        "/Library/Compositions", "/Library/CoreImage", "/Library/Automator", "/Library/Speech/Voices", "/Library/ColorSync/Profiles",
        "/Library/Documentation/Help"],
      "depth": 1, "group": "Extensions", "tier": "normal", "needsRoot": true, "match": ["bundleID", "subBundleID", "name", "vendor", "pluginBundleID", "pkgReceipt"], "nameStyle": "bundleName" },
    { "id": "local-drivers", "roots": ["/Library/Filesystems", "/Library/Printers", "/Library/Printers/PPDs/Contents/Resources", "/private/etc/cups/ppd",
        "/Library/Image Capture/Devices", "/Library/Image Capture/TWAIN Data Sources", "/Library/Security/SecurityAgentPlugins"],
      "depth": 1, "group": "Drivers", "tier": "caution", "needsRoot": true, "match": ["bundleID", "name", "vendor", "pluginBundleID", "pkgReceipt"], "nameStyle": "bundleName" },
    { "id": "local-library-vendor", "root": "/Library", "depth": 1, "group": "Application Support", "tier": "normal", "needsRoot": true,
      "match": ["name", "vendor"], "nameStyle": "folder", "onlyNonStandard": true },
    { "id": "local-receipts", "root": "/private/var/db/receipts", "depth": 1, "group": "Receipts", "tier": "safe", "needsRoot": true,
      "match": ["pkgReceipt"], "nameStyle": "receipt" },
    { "id": "shared-users", "roots": ["/Users/Shared", "/Users/Shared/Library/Application Support"], "depth": 1, "group": "Shared", "tier": "caution", "needsRoot": true,
      "match": ["name", "vendor", "bundleID"], "nameStyle": "folder" },
    { "id": "usr-local", "roots": ["/usr/local/bin", "/usr/local/sbin", "/usr/local/lib", "/usr/local/libexec", "/usr/local/share", "/usr/local/etc",
        "/usr/local/opt", "/usr/local/var", "/usr/local/include"],
      "depth": 1, "group": "CLI Tools", "tier": "normal", "needsRoot": true, "match": ["symlinkIntoApp", "pkgReceipt", "executable"], "nameStyle": "folder" },
    { "id": "opt", "root": "/opt", "depth": 1, "group": "CLI Tools", "tier": "caution", "needsRoot": true,
      "match": ["name", "vendor", "pkgReceipt"], "nameStyle": "folder", "skipChildren": ["homebrew", "X11", "local"] },
    { "id": "homebrew-bin", "roots": ["/opt/homebrew/bin", "/usr/local/Homebrew/bin"], "depth": 1, "group": "CLI Tools", "tier": "normal", "needsRoot": true,
      "match": ["symlinkIntoApp"], "nameStyle": "folder" },
    { "id": "etc-paths", "roots": ["/etc/paths.d", "/etc/manpaths.d", "/etc/resolver", "/etc/sudoers.d", "/etc/pam.d", "/etc/newsyslog.d", "/etc/profile.d"],
      "depth": 1, "group": "Shell Integration", "tier": "caution", "needsRoot": true, "match": ["name", "vendor", "fileContentIntoApp"], "nameStyle": "folder" },
    { "id": "var-log", "root": "/private/var/log", "depth": 1, "group": "Logs", "tier": "safe", "needsRoot": true,
      "match": ["name", "executable", "vendor"], "nameStyle": "log" },
    { "id": "root-library", "roots": ["/private/var/root/Library/Caches", "/private/var/root/Library/Application Support", "/private/var/root/Library/Preferences", "/private/var/root/Library/Logs"],
      "depth": 1, "group": "Caches", "tier": "safe", "needsRoot": true, "match": ["bundleID", "subBundleID", "name", "vendor"], "nameStyle": "plist" },
    { "id": "tmp", "roots": ["/private/tmp", "/private/var/tmp"], "depth": 1, "group": "Temporary Files", "tier": "safe", "needsRoot": true,
      "match": ["bundleID", "name", "executable", "vendor"], "nameStyle": "folder" },
    { "id": "native-messaging-hosts", "roots": [
        "~/Library/Application Support/Google/Chrome/NativeMessagingHosts", "~/Library/Application Support/Google/Chrome Beta/NativeMessagingHosts",
        "~/Library/Application Support/Google/Chrome Canary/NativeMessagingHosts", "~/Library/Application Support/Google/Chrome Dev/NativeMessagingHosts",
        "~/Library/Application Support/Chromium/NativeMessagingHosts", "~/Library/Application Support/BraveSoftware/Brave-Browser/NativeMessagingHosts",
        "~/Library/Application Support/Microsoft Edge/NativeMessagingHosts", "~/Library/Application Support/Microsoft Edge Beta/NativeMessagingHosts",
        "~/Library/Application Support/Vivaldi/NativeMessagingHosts", "~/Library/Application Support/Arc/User Data/NativeMessagingHosts",
        "~/Library/Application Support/Mozilla/NativeMessagingHosts", "/Library/Google/Chrome/NativeMessagingHosts",
        "/Library/Application Support/Mozilla/NativeMessagingHosts", "/Library/Application Support/Google/Chrome/External Extensions"],
      "depth": 1, "group": "Browser Integration", "tier": "normal", "needsRoot": true, "match": ["bundleID", "subBundleID", "name", "jsonPathIntoApp"], "nameStyle": "json" }
  ],
